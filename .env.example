# ==============================================================================
# GASHA — Environment Configuration Template
# Copy this file to .env and configure the appropriate variables.
# NEVER COMMIT THE ACTUAL .env FILE OR REAL CREDENTIALS.
# Generate secrets: python scripts/dev/generate_secrets.py
# Full reference: docs/environment-variables.md
# DB provisioning: docs/database-provisioning.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM & API CONFIGURATION (apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:4000/api/v1
WEB_URL=http://localhost:3000
LOG_LEVEL=debug
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Persistence: memory (default host demo) | sql
GASHA_STORAGE_BACKEND=memory
# sqlite (default host) | postgres (Supabase or Compose Postgres after migrations)
GASHA_DB_DIALECT=sqlite
# GASHA_DATABASE_PATH=   # optional; defaults to apps/data/gasha_storage.db

# ------------------------------------------------------------------------------
# 2. SUPABASE & DATABASE CONFIGURATION (Backend, DevOps & Frontend)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Prefer Supabase Session pooler (port 5432), NOT the direct db.* host on free plans.
# Example shape (replace host/password): 
# DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@aws-0-REGION.pooler.supabase.com:5432/postgres
DIRECT_URL=
REDIS_URL=redis://localhost:6379

# Frontend Supabase keys (optional; web MVP may not consume these yet)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Scratch DB for apps/api/tests/integration only (never the demo DB)
# GASHA_TEST_DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-jwt-key-change-in-production-min32chars
JWT_EXPIRES_IN=24h
INTERNAL_API_KEY=gasha-internal-service-key-change-me
CREDENTIAL_ENCRYPTION_KEY=
# Required when production_guard runs and the DB has no admin yet (min 32 chars)
GASHA_PROVISIONING_TOKEN=

# ------------------------------------------------------------------------------
# 4. EXTERNAL CLOUD INTEGRATIONS (Vercel & GitHub)
# ------------------------------------------------------------------------------
# Runtime connect API accepts tokens in the request body; these are optional defaults.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_WEBHOOK_SECRET=

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Demo preflight (scripts/demo/preflight.py) may check a PAT separately from App OAuth:
# GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 5. DETERMINISTIC SECURITY PIPELINE (AI / LLM & Live OSINT Decoupled)
# ------------------------------------------------------------------------------
# GASHA operates deterministically. No external AI/LLM keys are required.

# ------------------------------------------------------------------------------
# 6. TELEMETRY INGESTION & SDK (packages/telemetry-sdk)
# ------------------------------------------------------------------------------
GASHA_TELEMETRY_ENDPOINT=http://localhost:4000/api/v1/telemetry/ingest
GASHA_TELEMETRY_API_KEY=gasha-telemetry-demo-key-2026
GASHA_TELEMETRY_ENVIRONMENT=env-prod
# Read from .env via settings extra keys (host env var injection may not apply):
MAX_BATCH_SIZE=100
BUFFER_CAPACITY=5000
MAX_PAYLOAD_BYTES=1048576
GASHA_TELEMETRY_FLUSH_INTERVAL_MS=1000
GASHA_TELEMETRY_BATCH_SIZE=20

# ------------------------------------------------------------------------------
# 7. FRONTEND (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api/v1
BACKEND_URL=http://127.0.0.1:4000
# NEXT_PUBLIC_USE_MOCK=true
# NEXT_PUBLIC_API_USER=
# NEXT_PUBLIC_API_PASSWORD=
# NEXT_PUBLIC_API_ENV=env-prod

# ------------------------------------------------------------------------------
# 8. DEMO / TUNNEL (scripts/demo)
# ------------------------------------------------------------------------------
# GASHA_PUBLIC_URL=https://your-subdomain.ngrok-free.app
# GASHA_API_URL=http://127.0.0.1:4000
# GASHA_WEB_URL=http://127.0.0.1:3000
# CLIENT_SITE_URL=https://your-hosted-demo-target.example

# ------------------------------------------------------------------------------
# 9. CONTROLLED DEMO TARGET APPLICATION (apps/demo-target)
# ------------------------------------------------------------------------------
DEMO_TARGET_PORT=3001
DEMO_TARGET_URL=http://localhost:3001
DEMO_TARGET_DB_URL=postgresql://demo_user:demo_password@localhost:5432/demo_target_db
DEMO_TARGET_SECRET=demo-target-session-secret
