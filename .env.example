# ==============================================================================
# GASHA — Environment Configuration Template
# Copy this file to .env and configure the appropriate variables.
# NEVER COMMIT THE ACTUAL .env FILE OR REAL CREDENTIALS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM & API CONFIGURATION (apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=127.0.0.1
API_BASE_URL=http://localhost:4000/api/v1
WEB_URL=http://localhost:3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# 2. SUPABASE & DATABASE CONFIGURATION (Backend, DevOps & Frontend)
# ------------------------------------------------------------------------------
# Supabase Project Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Connection String (Direct or Supabase Transaction Pooler)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres
REDIS_URL=redis://localhost:6379

# Frontend Supabase Public Keys (apps/web)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Storage Engine Configuration (sql is mandatory for production; memory is for local testing only)
GASHA_STORAGE_BACKEND=sql
GASHA_DATABASE_PATH=data/gasha_storage.db

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECRET LIFECYCLE MANAGEMENT
# ------------------------------------------------------------------------------
# [PERSISTENT SECRETS]
# These keys must remain stable and unchanged across normal server restarts.
# Generate once, store in a protected local .env or secret store, and reload on restart.
#
# 1. JWT Signing Secret (Minimum 32-character high-entropy secret)
JWT_SECRET=your-production-jwt-secret-minimum-32-characters
JWT_EXPIRES_IN=24h

# 2. Internal Service API Key (Server-to-server operations & telemetry coordination)
INTERNAL_API_KEY=your-production-internal-service-key-minimum-32-chars

# 3. Credential Encryption Key (32-byte URL-safe base64 Fernet key)
# Used to encrypt third-party credentials (GitHub, Vercel tokens) at rest in the database.
# MUST BE PRESERVED: changing this key makes existing stored credentials unreadable!
CREDENTIAL_ENCRYPTION_KEY=your-32-byte-fernet-key-base64=

# [ONE-TIME CREDENTIALS]
# 4. Initial Administrator Bootstrap Provisioning Token
# Required ONLY on first startup of an unprovisioned database.
# Used once via POST /api/v1/auth/provision-admin to create root administrator.
# MUST BE RETIRED/UNSET after successful initial provisioning.
GASHA_PROVISIONING_TOKEN=your-high-entropy-one-time-provisioning-token=

# ------------------------------------------------------------------------------
# 4. EXTERNAL CLOUD INTEGRATIONS (Vercel & GitHub)
# ------------------------------------------------------------------------------
# Vercel Integration
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_WEBHOOK_SECRET=

# GitHub Integration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. DETERMINISTIC SECURITY PIPELINE (AI / LLM & Live OSINT Decoupled)
# ------------------------------------------------------------------------------
# GASHA operates 100% deterministically using authoritative environment telemetry,
# static rule catalogs, sliding-window correlation, and grounded investigations.
# Zero external AI/LLM API keys or local model providers (Ollama) are required.

# ------------------------------------------------------------------------------
# 6. TELEMETRY INGESTION & SDK (packages/telemetry-sdk)
# ------------------------------------------------------------------------------
GASHA_TELEMETRY_ENDPOINT=http://localhost:4000/api/v1/telemetry/ingest
GASHA_TELEMETRY_API_KEY=gasha-telemetry-demo-key-2026
GASHA_TELEMETRY_ENVIRONMENT=env-prod
GASHA_TELEMETRY_FLUSH_INTERVAL_MS=1000
GASHA_TELEMETRY_BATCH_SIZE=20
MAX_BATCH_SIZE=100
MAX_PAYLOAD_BYTES=1048576
BUFFER_CAPACITY=5000

# ------------------------------------------------------------------------------
# 7. CONTROLLED DEMO TARGET APPLICATION (apps/demo-target)
# ------------------------------------------------------------------------------
DEMO_TARGET_PORT=3001
DEMO_TARGET_URL=http://localhost:3001
DEMO_TARGET_DB_URL=postgresql://demo_user:demo_password@localhost:5432/demo_target_db
DEMO_TARGET_SECRET=demo-target-session-secret
