{
  "name": "gasha",
  "version": "0.1.0",
  "private": true,
  "description": "GASHA — Graph-Adaptive Security & Hardening Architecture",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:all": "python run_all.py",
    "start:all": "python run_all.py",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:contracts": "pnpm --filter @gasha/contracts typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^1.13.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.0.0"
}
